<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_sys_dark_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Top M3 Brand Caption -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.12"
        android:text="HANDLY"
        android:textColor="@color/m3_sys_dark_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Center Expressive Content Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- M3 Expressive Glowing Icon Frame -->
        <FrameLayout
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:background="@drawable/bg_orb_idle">

            <ImageView
                android:id="@+id/onboarding_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="Permission Icon"
                android:src="@drawable/ic_ride"
                app:tint="@color/m3_sys_dark_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/onboarding_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:letterSpacing="0.04"
            android:text="BLUETOOTH"
            android:textColor="@color/m3_sys_dark_on_surface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onboarding_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="16dp"
            android:text="Find and connect to your motorcycle."
            android:textColor="@color/m3_sys_dark_on_surface_variant"
            android:textSize="16sp" />

        <!-- M3 Expressive Pill Step Indicator Dots -->
        <LinearLayout
            android:id="@+id/onboarding_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_1"
                android:layout_width="24dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_active" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot_inactive" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot_inactive" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom M3 Expressive Pill Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_onboarding_next"
        style="@style/Widget.OpenCfMoto.Button.Connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="CONTINUE" />

</LinearLayout>
