<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_sys_dark_surface"
    tools:context=".MainActivity">

    <!-- Top Minimalist Chrome -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.12"
            android:text="HANDLY"
            android:textColor="@color/m3_sys_dark_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- M3 Expressive Settings Icon Button -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_container">

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/m3_sys_dark_on_surface" />
        </FrameLayout>
    </LinearLayout>

    <!-- Center Hero Cockpit Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp">

        <!-- Animated Center Orb -->
        <FrameLayout
            android:id="@+id/orb_container"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:background="@drawable/bg_orb_idle">

            <ImageView
                android:id="@+id/orb_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="Connection Status"
                android:src="@drawable/ic_ride"
                app:tint="@color/m3_sys_dark_on_surface" />

            <ProgressBar
                android:id="@+id/orb_progress"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/m3_sys_dark_primary"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Status Title -->
        <TextView
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.04"
            android:text="CONNECT"
            android:textColor="@color/m3_sys_dark_on_surface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Status Subtitle / Status Subtext -->
        <TextView
            android:id="@+id/status_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Turn on your motorcycle to get started."
            android:textColor="@color/m3_sys_dark_on_surface_variant"
            android:textSize="15sp" />

        <!-- Connected Bike Badge (M3 Expressive Tonal Pill) -->
        <TextView
            android:id="@+id/connected_bike_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_badge"
            android:letterSpacing="0.04"
            android:paddingHorizontal="18dp"
            android:paddingVertical="6dp"
            android:textColor="@color/m3_sys_dark_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="VOGE DS800" />
    </LinearLayout>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="28dp">

        <!-- 1. Primary Connect / Reconnect Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect"
            style="@style/Widget.OpenCfMoto.Button.Connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONNECT" />

        <!-- 2. Connected Actions View Group -->
        <LinearLayout
            android:id="@+id/connected_actions_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Hero Navigation Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_nav"
                style="@style/Widget.OpenCfMoto.Button.Connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NAVIGATION"
                app:icon="@drawable/ic_nav_arrow"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="22dp"
                app:iconTint="@color/m3_sys_dark_on_primary" />

            <!-- Navigation App Selector Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nav_gmaps"
                    style="@style/Widget.OpenCfMoto.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Google Maps"
                    app:icon="@drawable/ic_place"
                    app:iconTint="@color/m3_sys_dark_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_nav_waze"
                    style="@style/Widget.OpenCfMoto.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Waze"
                    app:icon="@drawable/ic_speed"
                    app:iconTint="@color/m3_sys_dark_primary" />
            </LinearLayout>

            <!-- Disconnect Action -->
            <TextView
                android:id="@+id/btn_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Disconnect"
                android:textColor="@color/m3_sys_dark_on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Hidden Legacy Views (for backward compat without breaking backend refs) -->
        <View
            android:id="@+id/status_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/status_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/bike_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_aa_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_mirror_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_gpx"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_aa_stop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_setup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_devices"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_trip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_hud_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_controls"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_diagnostics"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_toggle_log"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/log_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/tips_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/log_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/status_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_navigate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <EditText
            android:id="@+id/et_destination"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_share_log"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/brand_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_about_page"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_check_update"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_problem_report"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btn_donate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/brand_version"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/bike_metadata"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

</RelativeLayout>
