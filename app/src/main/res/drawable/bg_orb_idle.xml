<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M3 Expressive Outer Ambient Tonal Glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/m3_sys_dark_surface_container_low" />
            <size android:width="180dp" android:height="180dp" />
        </shape>
    </item>
    <!-- M3 Expressive Middle Surface Container Ring -->
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/m3_sys_dark_surface_container" />
            <stroke android:width="1.5dp" android:color="@color/m3_sys_dark_outline_variant" />
        </shape>
    </item>
    <!-- M3 Expressive Inner Surface Container High Core -->
    <item android:top="28dp" android:bottom="28dp" android:left="28dp" android:right="28dp">
        <shape android:shape="oval">
            <solid android:color="@color/m3_sys_dark_surface_container_high" />
        </shape>
    </item>
</layer-list>
