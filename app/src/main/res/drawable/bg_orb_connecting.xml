<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M3 Expressive Pulsing Primary Aura -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#28FF772A" />
            <size android:width="180dp" android:height="180dp" />
        </shape>
    </item>
    <!-- M3 Expressive Primary Container Ring -->
    <item android:top="14dp" android:bottom="14dp" android:left="14dp" android:right="14dp">
        <shape android:shape="oval">
            <solid android:color="@color/m3_sys_dark_surface_container" />
            <stroke android:width="2dp" android:color="@color/m3_sys_dark_primary" />
        </shape>
    </item>
    <!-- M3 Expressive Inner Core -->
    <item android:top="26dp" android:bottom="26dp" android:left="26dp" android:right="26dp">
        <shape android:shape="oval">
            <solid android:color="@color/m3_sys_dark_surface_container_high" />
        </shape>
    </item>
</layer-list>
